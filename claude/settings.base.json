{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "effortLevel": "xhigh",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/context-bar.sh"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/scripts/skills-session-start.sh",
            "shell": "bash",
            "async": false
          }
        ]
      }
    ]
  }
}
